{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "stage": "S5 / G5",
    "status": "draft-awaiting-figma",
    "direction": "Один жест",
    "date": "2026-11-04",
    "figmaFile": "https://www.figma.com/design/WiHJaCOSLNO9rsHwnRmRz5/Untitled",
    "figmaWriteMethod": "desktop_ui",
    "figmaCreated": false,
    "blocker": "Figma Desktop: Some changes won't be synced until Figma is able to reconnect.",
    "note": "Черновик для последующей сборки и проверки в Figma. Не является утверждённой основой G5. Шрифты и компоненты ещё не проверены на холсте."
  },
  "paletteOptions": {
    "signal": {
      "label": "Сигнальный красный",
      "recommended": true,
      "background": "#050505",
      "surface": "#151414",
      "text": "#F1EEE7",
      "secondaryText": "#B6B2AD",
      "imageAccent": "#E51D2A",
      "actionBackground": "#CF1826",
      "actionText": "#F1EEE7",
      "contrast": { "textOnBackground": 17.59, "secondaryTextOnBackground": 9.67, "actionTextOnAction": 4.75, "actionOnBackground": 3.70 },
      "rationale": "Ближе всего к G3. Красный макрообъекта сохранён, а красный CTA затемнён для читаемого светлого текста."
    },
    "ember": {
      "label": "Тёплый красный",
      "recommended": false,
      "background": "#080707",
      "surface": "#191515",
      "text": "#F7F1E8",
      "secondaryText": "#BBB1AA",
      "imageAccent": "#C92B32",
      "actionBackground": "#C92B32",
      "actionText": "#F7F1E8",
      "contrast": { "textOnBackground": 17.92, "actionTextOnAction": 4.83, "actionOnBackground": 3.71 },
      "rationale": "Более спокойная тёплая подача при той же чёрно-красной концепции."
    },
    "flash": {
      "label": "Яркий импульс",
      "recommended": false,
      "background": "#040608",
      "surface": "#14171A",
      "text": "#F3F4F1",
      "secondaryText": "#B2B7BA",
      "imageAccent": "#FA3E46",
      "actionBackground": "#FA3E46",
      "actionText": "#040608",
      "contrast": { "textOnBackground": 18.38, "actionTextOnAction": 5.65, "actionOnBackground": 5.65 },
      "rationale": "Самый броский красный; на CTA требует тёмной надписи."
    }
  },
  "recommendedTokens": {
    "color": {
      "background": "#050505",
      "surface": "#151414",
      "surfaceRaised": "#242222",
      "textPrimary": "#F1EEE7",
      "textSecondary": "#B6B2AD",
      "textMuted": "#797775",
      "accentImage": "#E51D2A",
      "action": "#CF1826",
      "actionHover": "#B91521",
      "actionPressed": "#A3121D",
      "actionText": "#F1EEE7",
      "focus": "#F1EEE7",
      "borderDecorative": "#343130",
      "borderInteractive": "#797775",
      "disabledBackground": "#343130",
      "disabledText": "#B6B2AD",
      "scrim": "rgba(5, 5, 5, 0.80)",
      "selectionBackground": "#CF1826",
      "selectionText": "#F1EEE7"
    },
    "typography": {
      "displayFamily": "Oswald",
      "bodyFamily": "Golos Text",
      "fallback": "sans-serif",
      "fontVerification": "pending-in-figma",
      "cyrillicSpecimen": "НАЧНИ. Найди свой формат. Женская группа. Ещё вопросы: Ж Щ Ю ё.",
      "display": { "weight": 700, "desktopSize": 160, "mobileSize": 80, "lineHeight": 0.95, "letterSpacingEm": -0.025, "usage": "Только короткая команда первого экрана; размер уточняется в G6 по кадрированию макрообъекта." },
      "heading1": { "weight": 600, "desktopSize": 80, "mobileSize": 48, "lineHeight": 1.05, "letterSpacingEm": -0.02 },
      "heading2": { "weight": 600, "desktopSize": 48, "mobileSize": 32, "lineHeight": 1.1, "letterSpacingEm": -0.015 },
      "body": { "weight": 400, "desktopSize": 18, "mobileSize": 16, "lineHeight": 1.5, "letterSpacingEm": 0, "maxMeasureCh": 68 },
      "bodySmall": { "weight": 400, "size": 14, "lineHeight": 1.5, "letterSpacingEm": 0, "usage": "Условия CTA; всегда читаемые и рядом с действием." },
      "action": { "weight": 600, "desktopSize": 18, "mobileSize": 16, "lineHeight": 1.25, "letterSpacingEm": 0 },
      "price": { "weight": 500, "size": 18, "lineHeight": 1.4, "numerals": "tabular" }
    },
    "grid": {
      "desktop": { "viewport": 1440, "columns": 12, "margin": 64, "gutter": 24, "contentMaxWidth": 1312 },
      "tablet": { "viewport": 768, "columns": 8, "margin": 32, "gutter": 24 },
      "mobile": { "viewport": 390, "columns": 4, "margin": 20, "gutter": 16, "contentWidth": 350 },
      "note": "Макроизображения могут выходить за сетку до края viewport. Текст и интерактивные области придерживаются безопасных полей."
    },
    "spacing": { "unit": 4, "scale": [4, 8, 12, 16, 20, 24, 32, 48, 64, 96, 128], "relatedItems": 8, "actionToCondition": 12, "groupGap": 24, "desktopSceneInset": 96, "mobileSceneInset": 64 },
    "shape": { "controlRadius": 2, "overlayRadiusDesktop": 12, "overlayRadiusMobile": 0, "borderWidth": 1, "iconStroke": 2, "minTarget": 48 },
    "elevation": { "method": "surface-and-scrim", "shadow": "none", "note": "Оверлей отделяется непрозрачной тёмной поверхностью и затемнением фона." },
    "focus": { "width": 2, "offset": 4, "color": "#F1EEE7", "innerGapColor": "#050505", "note": "Двухконтрастное кольцо сохраняет видимость на красном и на макрофото." }
  },
  "components": {
    "primaryAction": {
      "label": "Пробное бесплатно",
      "minHeight": 56,
      "paddingInline": 24,
      "gap": 16,
      "radius": 2,
      "states": {
        "default": { "fill": "#CF1826", "text": "#F1EEE7" },
        "hover": { "fill": "#B91521", "text": "#F1EEE7" },
        "pressed": { "fill": "#A3121D", "text": "#F1EEE7" },
        "focus": { "fill": "#CF1826", "ring": "recommendedTokens.focus" },
        "disabled": { "fill": "#343130", "text": "#B6B2AD", "note": "В текущем сценарии внешний переход всегда доступен; disabled — библиотечное состояние." }
      },
      "condition": "Первое занятие в общей, детской или женской группе — бесплатно. Мини-группы не участвуют.",
      "conditionStyle": "bodySmall / textSecondary",
      "note": "Доступное имя должно включать видимую подпись «Пробное бесплатно». Условие связывается с действием как описание; длинное доступное имя из G4 требует согласования оркестратором."
    },
    "secondaryAction": { "label": "Все цены и условия", "minHeight": 48, "paddingInline": 0, "fill": "transparent", "text": "#F1EEE7", "hover": "underline", "pressed": "underline", "focus": "recommendedTokens.focus", "disabledText": "#797775", "underlineOffset": 4 },
    "menuControl": { "accessibleLabelClosed": "Открыть меню", "accessibleLabelOpen": "Закрыть меню", "size": 56, "mobileSize": 48, "stroke": 2, "strokeColor": "#F1EEE7", "fill": "transparent", "hoverFill": "#242222", "focus": "recommendedTokens.focus", "note": "Закрыто: две горизонтальные линии. Открыто: крест, нарисованный векторами той же толщины." },
    "overlay": { "desktopMaxWidth": 800, "desktopPadding": 48, "mobilePadding": 24, "mobileWidth": "100%", "mobileHeight": "100dvh", "fill": "#151414", "scrim": "rgba(5, 5, 5, 0.80)", "radiusDesktop": 12, "radiusMobile": 0, "closeLabel": "Закрыть", "closeTarget": 48, "closeSticky": true, "focusManagement": "trap-and-return", "escapeCloses": true, "longContent": "vertical-scroll", "nestedModals": false },
    "statusPolicy": { "loading": "Внешний WhatsApp-переход не имитирует загрузку или отправку; у карты допускается геометрический placeholder без текста из головы.", "error": "Использовать утверждённые сообщения из docs/copy/home.md и error.md.", "empty": "Пустая выдача и формы не предусмотрены картой; не создавать искусственные состояния." }
  },
  "verification": {
    "contrastMethod": "WCAG relative luminance, sRGB; calculated locally with Node",
    "requiredNormalText": 4.5,
    "requiredLargeText": 3,
    "figmaFontAvailability": "not-verified",
    "figmaCyrillicRendering": "not-verified",
    "figmaAutoLayoutComponents": "not-created",
    "figmaExport": "not-created",
    "mcpReadsUsed": 0
  }
}
