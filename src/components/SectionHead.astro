---
// Шапка секции по референсу example (SectionHead): border-t, индекс-flame,
// линия, метка; заголовок с контурным словом и flame-точкой через слот.
interface Props {
  index: string;
  label: string;
}
const { index, label } = Astro.props;
---

<div class="mt-16 border-t border-line md:mt-24">
  <div class="mx-auto w-full max-w-[1536px] px-5 pt-10 md:px-10 md:pt-14">
    <div class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.28em] text-mut">
      <span class="text-flame">{index}</span>
      <span class="h-px w-10 bg-line" aria-hidden></span>
      <span>{label}</span>
    </div>
    <h2 class="mt-6 font-display text-4xl font-semibold uppercase leading-[0.95] tracking-[0.025em] md:text-6xl">
      <slot />
    </h2>
  </div>
</div>
