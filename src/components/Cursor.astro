---
// Кастомный курсор по референсу example: точка + кольцо, следуют за указателем.
// Включается JS только на точных указателях без prefers-reduced-motion.
---

<div id="cursor" aria-hidden="true">
  <div data-cursor-ring class="fixed left-0 top-0 z-[90] h-10 w-10 -translate-x-1/2 -translate-y-1/2 rounded-full border border-bright/60 will-change-transform"></div>
  <div data-cursor-dot class="fixed left-0 top-0 z-[90] h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-flame will-change-transform"></div>
</div>
