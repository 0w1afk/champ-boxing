---
import { COOKIE, FOOTER } from '../data/site';

// Уведомление о cookie с согласием (consent.ts): показывается, пока посетитель не
// выбрал «Принять» или «Отказаться»; выбор хранится в localStorage. Метрика
// грузится только после «Принять». Не модальное: фокус не перехватывает, страница
// работает и без выбора. Без JS остаётся скрытым (без JS Метрика и не работает).
---

<section
  data-consent
  hidden
  aria-label="Уведомление о файлах cookie"
  class="fixed inset-x-0 bottom-0 z-[70] border-t border-line bg-surface/95 backdrop-blur-sm"
>
  <div class="mx-auto flex w-full max-w-[1536px] flex-col gap-4 px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-5 md:flex-row md:items-center md:justify-between md:gap-10 md:px-10">
    <p class="max-w-3xl text-sm leading-relaxed text-mut">
      {COOKIE.text}<br />
      {COOKIE.note}
      <a href={FOOTER.privacy.href} class="text-ink underline underline-offset-4 transition-colors duration-300 hover:text-bright">{COOKIE.policy}</a>.
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        type="button"
        data-consent-decline
        class="flex-1 border border-line px-6 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-ink transition-colors duration-300 hover:border-flame hover:text-bright md:flex-none"
      >
        {COOKIE.decline}
      </button>
      <button
        type="button"
        data-consent-accept
        class="flex-1 border border-flame bg-flame px-6 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-bg transition-colors duration-300 hover:border-bright hover:bg-bright md:flex-none"
      >
        {COOKIE.accept}
      </button>
    </div>
  </div>
</section>
