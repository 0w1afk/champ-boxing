---
import { TICKER } from '../data/site';

// Тикер под хиро: Swiper в режиме непрерывной прокрутки (delay 0), пауза на hover.
// Без JS и при prefers-reduced-motion строка остаётся статичной.
---

<div class="ticker overflow-hidden border-y border-line py-4">
  <div class="swiper ticker-swiper" data-ticker>
    <div class="swiper-wrapper items-center">
      {TICKER.map((t) => (
        <div class="swiper-slide !w-auto flex items-center whitespace-nowrap">
          <span class="font-display text-sm font-medium uppercase tracking-[0.28em] text-mut">{t}</span>
          <span class="mx-8 inline-block h-2 w-2 rotate-45 bg-flame" aria-hidden="true"></span>
        </div>
      ))}
    </div>
  </div>
</div>
