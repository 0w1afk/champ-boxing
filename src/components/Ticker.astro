---
// Бегущая строка: 8 утверждённых фактов G4, пауза без JS-фреймворков.
const ITEMS = [
  'Первое занятие в группе — бесплатно, кроме мини-групп',
  'Спарринги — только по желанию',
  'Пять тренеров: два мастера спорта и три кандидата в мастера спорта',
  'Абонемент на 12 занятий действует 45 дней',
  'Мини-группа — до 5 человек',
  'Детская группа — с 7 лет',
  'Хабаровск, Восточное шоссе, 41, 3 этаж',
  'Индивидуальная пробная — 1 500 ₽',
];
const sep = '<span class="mx-5 flex items-center gap-5 md:mx-6"><span>·</span><span class="inline-block h-2 w-2 rotate-45 bg-bright" aria-hidden="true"></span></span>';
const rowHtml = ITEMS.join(sep);
const rowClass = 'flex items-center font-display text-[clamp(0.8125rem,1vw,0.875rem)] font-medium uppercase tracking-[0.28em] text-mut';
---

<div role="group" aria-labelledby="ticker-label" class="w-full min-w-0 overflow-hidden border-t border-line py-4">
  <p id="ticker-label" class="sr-only">Ключевые факты о клубе</p>
  <div id="ticker-marquee" class="animate-marquee flex w-max">
    <div class="flex w-max shrink-0 items-center whitespace-nowrap">
      <span class={rowClass} set:html={rowHtml} />
    </div>
    <div aria-hidden="true" class="flex w-max shrink-0 items-center whitespace-nowrap">
      <span class={rowClass} set:html={rowHtml} />
    </div>
  </div>
</div>
<div class="border-t border-line px-5 py-3 md:px-10">
  <button
    type="button"
    id="ticker-toggle"
    aria-label="Пауза тикера"
    class="inline-flex h-12 items-center gap-2 border border-line px-5 font-display text-xs font-semibold uppercase tracking-[0.2em] transition duration-200 hover:border-flame hover:text-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright"
  >
    <span aria-hidden="true">▮▮</span> <span id="ticker-toggle-text">Пауза</span>
  </button>
</div>

<script>
  const btn = document.getElementById('ticker-toggle');
  const marquee = document.getElementById('ticker-marquee');
  const text = document.getElementById('ticker-toggle-text');
  if (btn && marquee && text) {
    let paused = false;
    btn.addEventListener('click', () => {
      paused = !paused;
      marquee.style.animationPlayState = paused ? 'paused' : 'running';
      text.textContent = paused ? 'Продолжить' : 'Пауза';
      btn.setAttribute('aria-label', paused ? 'Продолжить тикер' : 'Пауза тикера');
    });
  }
</script>
