---
import { TICKER } from '../data/site';

// Тикер по референсу example: две копии (вторая aria-hidden), ромб-flame разделитель,
// marquee 32s, пауза на hover; при prefers-reduced-motion — статичная строка.
---

<div class="ticker overflow-hidden border-y border-line py-4">
  <div class="animate-marquee flex w-max">
    <div class="flex w-max shrink-0 items-center whitespace-nowrap">
      {TICKER.map((t) => (
        <span class="flex items-center">
          <span class="font-display text-sm font-medium uppercase tracking-[0.28em] text-mut">{t}</span>
          <span class="mx-8 inline-block h-2 w-2 rotate-45 bg-flame" aria-hidden="true"></span>
        </span>
      ))}
    </div>
    <div aria-hidden="true" class="flex w-max shrink-0 items-center whitespace-nowrap">
      {TICKER.map((t) => (
        <span class="flex items-center">
          <span class="font-display text-sm font-medium uppercase tracking-[0.28em] text-mut">{t}</span>
          <span class="mx-8 inline-block h-2 w-2 rotate-45 bg-flame" aria-hidden="true"></span>
        </span>
      ))}
    </div>
  </div>
</div>
