---
import { HERO, MSG, wa } from '../data/site';
import Ticker from './Ticker.astro';
import Placeholder from './Placeholder.astro';
---

<section id="top" class="relative flex min-h-[100dvh] flex-col pt-16 lg:h-[100dvh] lg:min-h-[700px]">
  {/* Контурное слово с параллаксом — вау-момент (aria-hidden) */}
  <div
    aria-hidden="true"
    data-hero-word
    class="pointer-events-none absolute -bottom-6 left-0 select-none font-display text-[34vw] font-bold uppercase leading-none tracking-tight"
  >
    <span class="text-stroke-faint">{HERO.contourWord}</span>
  </div>

  <div class="mx-auto grid w-full max-w-[1536px] min-h-0 flex-1 grid-cols-1 gap-10 px-5 pb-8 pt-6 md:px-10 lg:grid-cols-12 lg:gap-8 lg:pt-8">
    {/* Левая колонка — типографика */}
    <div class="flex flex-col justify-center lg:col-span-7">
      <div class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.3em] text-mut">
        <span class="h-2 w-2 rotate-45 bg-flame" aria-hidden></span>
        {HERO.label}
      </div>

      <h1 class="mt-5 font-display font-semibold uppercase leading-[0.9] tracking-[0.025em]">
        <span class="block text-[clamp(3.5rem,8.5vw,7.75rem)]">{HERO.hookLine1}</span>
        <span class="block text-[clamp(3.5rem,8.5vw,7.75rem)]">
          <span class="text-stroke-flame">{HERO.hookLine2}</span><span class="text-flame">.</span>
        </span>
      </h1>

      <p class="mt-4 max-w-md text-base leading-relaxed text-mut md:text-lg">{HERO.support}</p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <span data-magnetic class="inline-flex">
          <a
            href={wa(MSG.base)}
            target="_blank"
            rel="noopener"
            aria-label="Пробное бесплатно — записаться на групповое занятие в WhatsApp"
            class="inline-flex items-center gap-3 bg-flame px-8 py-4 text-sm font-semibold uppercase tracking-[0.2em] text-bg transition-colors duration-300 hover:bg-bright active:bg-press"
          >
            {HERO.cta}
          </a>
        </span>
        <a
          href={HERO.next.href}
          class="inline-flex items-center gap-3 border border-line px-8 py-4 text-sm font-semibold uppercase tracking-[0.2em] transition-colors duration-300 hover:border-flame hover:text-bright"
        >
          {HERO.next.label}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden>
            <path d="M8 2v12M3 9l5 5 5-5" />
          </svg>
        </a>
      </div>
      <p class="mt-3 text-xs leading-relaxed text-mut/80">{HERO.condition}</p>
      <p class="mt-1 max-w-md text-xs text-mut/80">
        Или позвоните:
        <a href="tel:+79144234555" class="whitespace-nowrap underline underline-offset-4 transition-colors hover:text-bright">{HERO.fallback.replace('Или позвоните: ', '')}</a>
      </p>

      <dl class="mt-4 grid max-w-xl grid-cols-3 gap-6">
        {HERO.stats.map((s) => (
          <div class="flex flex-col border-l border-line pl-4">
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-display text-3xl font-semibold text-ink md:text-4xl">{s.value}</dd>
            <dd class="mt-1 text-[10px] uppercase tracking-[0.15em] text-mut">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    {/* Правая колонка — изображение-заглушка с бейджами */}
    <div class="relative lg:col-span-5">
      <div class="relative h-[52vh] min-h-[380px] lg:h-full">
        <Placeholder label="Иллюстрация: боксёр в защитном шлеме, крупный план" parallax class="h-full w-full">
          <img
            src="/img/hero-boxer.png"
            alt="Иллюстрация: боксёр в защитном шлеме, крупный план половины лица"
            class="h-full w-full object-cover"
          />
        </Placeholder>
        <div class="absolute left-4 top-4 z-[2] flex items-center gap-2 border border-line bg-bg/85 px-3 py-2 backdrop-blur-sm">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-flame opacity-60" aria-hidden></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-flame" aria-hidden></span>
          </span>
          <span class="text-[11px] font-semibold uppercase tracking-[0.22em]">{HERO.badgeTop}</span>
        </div>
        <div class="absolute bottom-0 left-0 z-[2] border-r border-t border-line bg-bg/85 px-4 py-2 backdrop-blur-sm">
          <span class="text-[11px] uppercase tracking-[0.22em] text-mut">{HERO.badgeBottom}</span>
        </div>
      </div>
    </div>
  </div>

  <Ticker />
</section>
