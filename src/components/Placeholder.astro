---
import LogoMark from './LogoMark.astro';

// Заглушка изображения: тёмная плоскость + halftone + подпись-слот (или знак клуба водяным знаком).
// Опционально: параллакс плоскости; дети через default-slot заменяют содержимое.
interface Props {
  label: string;
  class?: string;
  parallax?: boolean | number;
  /** Декоративный фон (подпись не выводится) — фоновые плоскости секций. */
  decor?: boolean;
  /** Водяной знак — знак клуба (перчатка в круге) по центру плоскости. */
  watermark?: boolean;
  /** Классы параллакс-слоя; по умолчанию запас -top-[10%] h-[120%] под дрейф. */
  parallaxShift?: string;
}
const {
  label,
  class: className = '',
  parallax = false,
  decor = false,
  watermark = false,
  parallaxShift = '-top-[10%] h-[120%]',
} = Astro.props;
const hasChildren = Astro.slots.has('default');
const parallaxAmount = typeof parallax === 'number' ? parallax : parallax ? 7 : 0;
---

<div class:list={[`halftone relative overflow-hidden border border-line bg-raised ${className}`]}>
  <div
    class:list={['absolute inset-x-0 flex items-center justify-center', parallaxShift]}
    data-parallax={parallaxAmount || undefined}
  >
    {hasChildren ? (
      <slot />
    ) : (
      <div class="flex flex-col items-center gap-5 px-6 text-center">
        {watermark && <LogoMark class="aspect-square h-56 max-h-[50%] w-auto text-flame opacity-80" />}
        {!decor && (
          <span class="text-[11px] uppercase tracking-[0.22em] text-mut/70">
            Изображение: {label}
          </span>
        )}
      </div>
    )}
  </div>
</div>
