---
import { NAV, PHONE_DISPLAY, MSG, wa } from '../data/site';
import { withBase } from '../lib/base';
import Logo from './Logo.astro';

// Шапка по референсу example: fixed, blur, логотип (Logo.astro), десктоп-навигация,
// полноэкранное мобильное меню на <details> (работает без JS). Активный раздел
// подсвечивается по aria-current (nav-active.ts): светлый текст, на десктопе —
// золотая линия под пунктом.
---

{/* Фон шапки — .site-header в global.css: на тач-экранах сплошной цвета страницы,
    на точных указателях — полупрозрачный с размытием */}
<header class="site-header fixed inset-x-0 top-0 z-50 border-b border-line">
  <div class="mx-auto flex h-16 w-full max-w-[1536px] items-center justify-between px-5 md:px-10">
    <a href={withBase('/#top')} class="group" aria-label="CHAMP BOXING CLUB — на главную">
      <Logo markClass="transition-transform duration-300 group-hover:scale-105" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Основная навигация">
      {NAV.map((n) => (
        <a
          href={n.href}
          class="relative py-1 text-xs font-medium uppercase tracking-[0.22em] text-mut transition-colors duration-300 after:absolute after:-bottom-0.5 after:left-0 after:right-[0.22em] after:h-px after:origin-left after:scale-x-0 after:bg-flame after:transition-transform after:duration-300 hover:text-bright aria-[current=location]:text-bright aria-[current=location]:after:scale-x-100"
        >
          {n.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <span data-magnetic class="hidden md:inline-flex">
        <a
          href={wa(MSG.base)}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center border border-flame px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-bright transition-colors duration-300 hover:bg-flame hover:text-bg"
        >
          Пробное бесплатно
        </a>
      </span>

      <details class="mobile-menu-trigger lg:hidden">
        <summary
          class="inline-flex h-11 w-11 items-center justify-center border border-line text-ink transition-colors hover:border-flame hover:text-bright"
          aria-label="Открыть меню"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden>
            <path d="M2 4.5h14M2 9h14M2 13.5h14" />
          </svg>
        </summary>
        <div class="mobile-menu lg:hidden" role="dialog" aria-modal="true" aria-label="Меню">
          <div class="flex h-16 items-center justify-between border-b border-line px-5">
            <Logo />
            <button
                type="button"
                class="inline-flex h-11 w-11 items-center justify-center border border-line transition-colors hover:border-flame hover:text-bright"
                aria-label="Закрыть меню"
                data-menu-close
              >
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden>
                  <path d="M3 3l12 12M15 3L3 15" />
                </svg>
              </button>
          </div>
          <nav class="flex flex-1 flex-col justify-center gap-1 overflow-y-auto px-6" aria-label="Мобильная навигация">
            {NAV.map((n, i) => (
              <a
                href={n.href}
                data-menu-close
                style={`--i: ${i}`}
                class="menu-item group flex items-baseline gap-4 border-b border-line py-4"
              >
                <span class="text-xs text-flame">0{i + 1}</span>
                <span class="font-display text-4xl font-medium uppercase tracking-[0.025em] transition-colors group-hover:text-bright group-aria-[current=location]:text-bright">
                  {n.label}
                </span>
              </a>
            ))}
          </nav>
          <div class="px-6 pb-6 pt-4">
            <a
              href={wa(MSG.base)}
              target="_blank"
              rel="noopener"
              data-menu-close
              class="flex w-full items-center justify-center bg-flame py-4 text-sm font-semibold uppercase tracking-[0.2em] text-bg"
            >
              Записаться на тренировку
            </a>
            <p class="mt-3 text-xs leading-relaxed text-mut">
              Первое занятие в общей, детской или женской группе — бесплатно, кроме мини-групп.
              <a href={withBase('/privacy/')} class="underline underline-offset-4 hover:text-bright">Политика конфиденциальности</a>.
            </p>
            <p class="mt-1 text-xs text-mut">
              Резерв: <a href="tel:+79144234555" class="underline underline-offset-4 hover:text-bright">{PHONE_DISPLAY}</a>
            </p>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
