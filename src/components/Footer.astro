---
import { FOOTER, NAV } from '../data/site';
---

<footer class="mt-auto border-t border-line">
  <div class="mx-auto flex w-full max-w-[1536px] flex-col gap-8 px-5 py-10 md:flex-row md:items-center md:justify-between md:px-10">
    <div class="flex items-center gap-3">
      <img src="/logo.png" alt="" width="36" height="33" class="h-9 w-auto" />
      <div>
        <p class="font-display text-base font-semibold uppercase tracking-[0.18em]">{FOOTER.name}</p>
        <p class="text-xs text-mut">{FOOTER.tagline} · © {new Date().getFullYear()}</p>
      </div>
    </div>

    <nav aria-label="Навигация в подвале" class="flex flex-wrap gap-x-6 gap-y-2">
      {NAV.map((n) => (
        <a href={n.href} class="text-[11px] font-medium uppercase tracking-[0.2em] text-mut transition-colors duration-300 hover:text-bright">
          {n.label}
        </a>
      ))}
    </nav>

    <div class="flex flex-wrap gap-6">
      {FOOTER.socials.map((s) =>
        s.href ? (
          <a
            href={s.href}
            target="_blank"
            rel="noopener"
            class="text-[11px] font-medium uppercase tracking-[0.2em] text-mut transition-colors duration-300 hover:text-bright"
          >
            {s.label}
          </a>
        ) : (
          <span class="text-[11px] font-medium uppercase tracking-[0.2em] text-mut">{s.label}</span>
        )
      )}
      <a href={FOOTER.privacy.href} class="text-[11px] font-medium uppercase tracking-[0.2em] text-mut underline underline-offset-4 transition-colors duration-300 hover:text-bright">
        {FOOTER.privacy.label}
      </a>
    </div>
  </div>
</footer>
