---
import { Image, getImage } from 'astro:assets';
import { GALLERY, GALLERY_ALT } from '../data/site';
import SectionHead from './SectionHead.astro';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/img/gallery/*.jpg', {
  eager: true,
});
const photos = await Promise.all(
  GALLERY.map(async (g) => {
    const src = files[`../assets/img/gallery/${g.n}.jpg`]!.default;
    const full = await getImage({ src, width: Math.min(1600, src.width), format: 'webp', quality: 80 });
    return { ...g, src, full: full.src };
  }),
);

// Фотостена — бесконечная горизонтальная лента во всю ширину, высота ~80vh,
// masonry в 2 ряда: слайд — колонка из двух фото, доли высоты чередуются 60/40 и 40/60.
// Ширина колонки (aspect-ratio) считается при сборке как среднее натуральных ширин
// обоих кадров при их доле высоты; кадры подрезаются object-cover. Нечётный последний
// кадр занимает колонку целиком. Крутит Embla (AutoScroll, ровный ход, мгновенная
// пауза при наведении), свайп с инерцией, горизонтальное колёсико; лайтбокс — свой <dialog>.
const SHARES = [
  [0.6, 0.4],
  [0.4, 0.6],
] as const;
const columns: { i: number; share: number }[][] = [];
for (let i = 0; i < photos.length; i += 2) {
  const col = columns.length;
  columns.push(
    i + 1 < photos.length
      ? [
          { i, share: SHARES[col % 2]![0] },
          { i: i + 1, share: SHARES[col % 2]![1] },
        ]
      : [{ i, share: 1 }],
  );
}
const ratio = (col: { i: number; share: number }[]) => {
  const widths = col.map(({ i, share }) => (share * photos[i]!.src.width) / photos[i]!.src.height);
  return (widths.reduce((a, b) => a + b, 0) / widths.length).toFixed(4);
};
---

<section id="gallery" class="pb-20 md:pb-28">
  <SectionHead index="05" label="Галерея">
    Клуб <span class="text-stroke-flame">в кадрах</span><span class="text-flame">.</span>
  </SectionHead>

  <div class="mx-auto mt-8 w-full max-w-[1536px] px-5 md:px-10">
    <p class="max-w-2xl text-base leading-relaxed text-mut md:text-lg" data-reveal>
      Фото с тренировок, турниров и выездов клуба. Наведи на кадр, чтобы снять сетку; нажми — откроется крупно.
    </p>
  </div>

  {/* Лента: без контейнера, во всю ширину экрана */}
  <div
    class="gallery-strip mt-10 h-[60vh] max-h-[760px] min-h-[320px] touch-pan-y touch-pinch-zoom overflow-hidden md:h-[80vh]"
    data-gallery-embla
  >
    {/* Embla: корень — вьюпорт, первый потомок — дорожка, её дети — слайды */}
    <div class="flex h-full">
      {columns.map((col) => (
        <div
          class="mr-[5px] flex h-full min-w-0 shrink-0 grow-0 flex-col gap-[5px]"
          style={`aspect-ratio: ${ratio(col)}`}
        >
          {col.map(({ i, share }) => (
            <button
              type="button"
              data-gallery-photo={String(i)}
              data-full={photos[i]!.full}
              aria-label={`Открыть фото ${i + 1} из ${GALLERY.length}`}
              class="group relative min-h-0 w-full cursor-pointer overflow-hidden border-0 bg-transparent p-0"
              style={`flex: ${share * 10} 1 0%`}
            >
              <Image
                src={photos[i]!.src}
                alt={`${GALLERY_ALT} — ${i + 1}`}
                widths={[480, 800, 1200]}
                sizes="(max-width: 767px) 70vw, 40vw"
                format="webp"
                quality={68}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover"
              />
              {/* Сетка и затемнение: снимаются при наведении на конкретный кадр */}
              <span
                class="gallery-veil pointer-events-none absolute inset-0 opacity-100 transition-opacity duration-300 group-hover:opacity-0"
                aria-hidden="true"
              />
            </button>
          ))}
        </div>
      ))}
    </div>
  </div>

  {/* Лайтбокс на нативном <dialog>: Esc и клик по фону закрывают, стрелки листают */}
  <dialog
    data-gallery-dialog
    aria-label="Фото галереи"
    class="m-auto h-dvh max-h-none w-full max-w-none border-0 bg-transparent p-0 backdrop:bg-bg/95"
  >
    <img
      data-gallery-full
      alt=""
      class="absolute inset-0 m-auto max-h-[86dvh] max-w-[94vw] object-contain"
    />
    <button
      type="button"
      data-gallery-prev
      aria-label="Предыдущее фото"
      class="absolute left-3 top-1/2 -translate-y-1/2 border border-line bg-bg/70 px-4 py-4 text-ink transition-colors hover:border-flame hover:text-bright"
    >
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden>
        <path d="M14 4l-7 7 7 7" />
      </svg>
    </button>
    <button
      type="button"
      data-gallery-next
      aria-label="Следующее фото"
      class="absolute right-3 top-1/2 -translate-y-1/2 border border-line bg-bg/70 px-4 py-4 text-ink transition-colors hover:border-flame hover:text-bright"
    >
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden>
        <path d="M8 4l7 7-7 7" />
      </svg>
    </button>
    <button
      type="button"
      data-gallery-close
      aria-label="Закрыть"
      class="absolute right-3 top-3 border border-line bg-bg/70 p-3 text-ink transition-colors hover:border-flame hover:text-bright"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden>
        <path d="M3 3l12 12M15 3L3 15" />
      </svg>
    </button>
    <p
      data-gallery-counter
      class="absolute bottom-4 left-1/2 -translate-x-1/2 font-display text-xs uppercase tracking-[0.28em] text-mut"
    >
    </p>
  </dialog>
</section>
