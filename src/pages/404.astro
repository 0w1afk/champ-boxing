---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Страница не найдена — CHAMP BOXING CLUB"
  description="Страница не найдена. Вернитесь на главную страницу CHAMP BOXING CLUB или позвоните в клуб."
>
  <meta slot="head" name="robots" content="noindex" />
  <Header />

  <main id="main" tabindex="-1" class="focus:outline-none">
    <section class="border-t border-line">
      <div class="mx-auto max-w-[1440px] px-5 py-16 md:px-10 md:py-32">
        <p class="font-display text-[clamp(4rem,12vw,9rem)] font-semibold uppercase leading-none text-flame" aria-hidden="true">404</p>
        <h1 class="mt-6 font-display text-[clamp(2rem,4.5vw,3.75rem)] font-semibold uppercase leading-none">Страница не найдена.</h1>
        <p class="mt-4 text-lg text-mut">Проверьте адрес или вернитесь на главную.</p>
        <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href="/" class="inline-flex h-14 items-center bg-flame px-8 font-display text-sm font-semibold uppercase tracking-[0.2em] text-[#0b0a09] transition duration-200 hover:bg-bright active:bg-press active:scale-[0.97] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright">На главную</a>
          <a href="tel:+79144234555" class="inline-flex h-14 items-center border border-line px-8 font-display text-sm font-semibold uppercase tracking-[0.2em] transition duration-200 hover:border-flame hover:text-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright">Позвонить: +7 (914) 423-45-55</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>
