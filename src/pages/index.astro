---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Ticker from '../components/Ticker.astro';

// WhatsApp deep-links: сообщения дословно из docs/copy/home.md (утверждены G1).
const WA = 'https://wa.me/79144234555';
const wa = (text: string) => `${WA}?text=${encodeURIComponent(text)}`;
const MSG = {
  common: 'Здравствуйте! Хочу на бесплатное первое занятие в общей группе. Подскажите время.',
  kids: 'Здравствуйте! Хочу записать ребёнка на пробное занятие в детскую группу. Подскажите время.',
  women: 'Здравствуйте! Хочу на бесплатное первое занятие в женской группе. Подскажите время.',
  mini: 'Здравствуйте! Интересует мини-группа (900 ₽ за занятие). Подскажите время.',
  split: 'Здравствуйте! Интересует сплит-тренировка на двоих. Подскажите время.',
  individual: 'Здравствуйте! Хочу на пробную индивидуальную тренировку за 1 500 ₽. Подскажите время.',
};

const coaches = [
  {
    name: 'Евгений Лелеков',
    photo: '/img/coaches/evgeny-lelekov.jpg',
    bio: 'Мастер спорта по&#160;боксу. Высшее образование — ДВГАФК. Тренирует групповые и&#160;персональные занятия. Тренерский стаж — более 5&#160;лет.',
  },
  {
    name: 'Виктор Кириченко',
    photo: '/img/coaches/viktor-kirichenko.jpg',
    bio: 'Кандидат в&#160;мастера спорта по&#160;боксу. Высшее образование — ДВГУПС. Тренирует групповые и&#160;персональные занятия. Тренерский стаж — более 5&#160;лет.',
  },
  {
    name: 'Константин Касьянов',
    photo: '/img/coaches/konstantin-kasyanov.jpg',
    bio: 'Мастер спорта по&#160;боксу. Высшее образование — ДВГАФК. Тренирует групповые и&#160;персональные занятия, имеет опыт работы с&#160;детьми. Тренерский стаж — более 13&#160;лет.',
  },
  {
    name: 'Виктор Мартынов',
    photo: '/img/coaches/viktor-martynov.jpg',
    bio: 'Кандидат в&#160;мастера спорта по&#160;боксу. Обучается в&#160;ДВГАФК. Тренирует групповые и&#160;персональные занятия. Тренерский стаж — более 2&#160;лет.',
  },
  {
    name: 'Роман Ефанов',
    photo: '/img/coaches/roman-efanov.jpg',
    bio: 'Кандидат в&#160;мастера спорта по&#160;боксу. Обучается в&#160;ДВГАФК. Тренирует групповые и&#160;персональные занятия. Тренерский стаж — более 3&#160;лет.',
  },
];

const faq = [
  {
    q: 'Что взять на&#160;первую тренировку?',
    a: 'Спортивную форму и&#160;удобную сменную обувь. Остальная экипировка потребуется на&#160;дальнейших этапах тренировок.',
    open: false,
  },
  { q: 'Можно прийти без спортивной подготовки?', a: 'Да. Начать можно без опыта занятий спортом.', open: false },
  {
    q: 'Как проходит тренировка?',
    a: 'Обычно это разминка, основная часть с&#160;отработкой приёмов и&#160;работой на&#160;мешках и&#160;лапах, затем растяжка.',
    open: false,
  },
  {
    q: 'Будут ли спарринги на первых тренировках?',
    a: 'Нет. Сначала отрабатываете удары и защиту. Спарринги начинаются позже и только по желанию.',
    open: true,
  },
  {
    q: 'Со скольких лет можно заниматься?',
    a: 'В детскую группу принимают с 7 лет. В клубе также тренируются взрослые до 60 лет. Тренер поможет подобрать нагрузку с учётом возраста и подготовки. Если не знаете, какая группа подходит, напишите — подскажем по возрасту и подготовке.',
    open: false,
  },
  { q: 'Есть женская группа?', a: 'Да. В&#160;ней занимаются девушки и&#160;женщины с&#160;любым уровнем подготовки.', open: false },
  {
    q: 'Сколько стоит первое занятие?',
    a: 'В общей, детской и женской группах оно бесплатно. В мини-группе занятие стоит 900 ₽; индивидуальная пробная тренировка — 1 500 ₽. Сплит-тренировка — 1&#160;400&#160;₽ за занятие.',
    open: false,
  },
  { q: 'Сколько действует абонемент?', a: 'Абонемент на&#160;12&#160;занятий действует 45&#160;дней.', open: false },
  { q: 'Как записаться и&#160;согласовать время?', a: 'Напишите в&#160;WhatsApp или позвоните: +7&#160;(914)&#160;423-45-55.', open: false },
];

const prices = [
  { name: 'Общая группа', single: '700&#160;₽', pass: '6&#160;000&#160;₽' },
  { name: 'Детская группа', single: '500&#160;₽', pass: '5&#160;000&#160;₽' },
  { name: 'Женская группа', single: '700&#160;₽', pass: '6&#160;000&#160;₽' },
  { name: 'Мини-группа', single: '900&#160;₽', pass: '7&#160;000&#160;₽' },
  { name: 'Сплит-тренировка', single: '1&#160;400&#160;₽', pass: '14&#160;000&#160;₽' },
  { name: 'Индивидуальная тренировка', single: '2&#160;000&#160;₽', pass: '20&#160;000&#160;₽' },
];

const formats = [
  {
    num: '01',
    name: 'Общая группа',
    mark: 'Новичкам и&#160;опытным',
    aria: 'Об общей группе',
    text: 'Для новичков и&#160;тех, кто уже занимался боксом. Техника, упражнения на&#160;скорость и&#160;выносливость; спарринги — позже и&#160;по&#160;желанию.',
    price: 'Разовое занятие — 700&#160;₽. Абонемент на&#160;12&#160;занятий — 6&#160;000&#160;₽, действует 45&#160;дней.',
    cond: 'Первое занятие в&#160;общей группе бесплатно.',
    cta: 'Записаться на&#160;бесплатное первое занятие',
    href: wa(MSG.common),
    open: true,
  },
  {
    num: '02',
    name: 'Детская группа',
    mark: 'От&#160;7&#160;лет',
    aria: 'О детской группе',
    text: 'Для детей от&#160;7&#160;лет. Техника бокса и&#160;подвижные упражнения помогают развивать координацию и&#160;дисциплину.',
    price: 'Разовое занятие — 500&#160;₽. Абонемент на&#160;12&#160;занятий — 5&#160;000&#160;₽, действует 45&#160;дней.',
    cond: 'Первое занятие в&#160;детской группе бесплатно.',
    cta: 'Записаться на&#160;бесплатное первое занятие',
    href: wa(MSG.kids),
    open: false,
  },
  {
    num: '03',
    name: 'Женская группа',
    mark: 'Любой уровень',
    aria: 'О женской группе',
    text: 'Для девушек и&#160;женщин с&#160;любым уровнем подготовки. Техника бокса, кардио и&#160;функциональные упражнения.',
    price: 'Разовое занятие — 700&#160;₽. Абонемент на&#160;12&#160;занятий — 6&#160;000&#160;₽, действует 45&#160;дней.',
    cond: 'Первое занятие в&#160;женской группе бесплатно.',
    cta: 'Записаться на&#160;бесплатное первое занятие',
    href: wa(MSG.women),
    open: false,
  },
  {
    num: '04',
    name: 'Мини-группа',
    mark: 'До&#160;5&#160;человек',
    aria: 'О мини-группе',
    text: 'До&#160;5&#160;человек. Для мужчин и&#160;женщин с&#160;любым уровнем подготовки.',
    price: 'Разовое занятие — 900&#160;₽. Абонемент на&#160;12&#160;занятий — 7&#160;000&#160;₽, действует 45&#160;дней.',
    cond: 'Занятие платное; бесплатное первое групповое занятие на&#160;мини-группу не&#160;распространяется.',
    cta: 'Записаться в&#160;мини-группу — 900&#160;₽ за&#160;занятие',
    href: wa(MSG.mini),
    open: false,
  },
  {
    num: '05',
    name: 'Сплит',
    mark: 'Двое с&#160;тренером',
    aria: 'О сплит-тренировке',
    text: 'Два человека занимаются с одним тренером. Можно прийти с другом, второй половинкой или членом семьи.',
    price: 'Разовое занятие — 1&#160;400&#160;₽. Абонемент на&#160;12&#160;занятий — 14&#160;000&#160;₽, действует 45&#160;дней.',
    cond: 'Занятие платное. Формат — двое с одним тренером.',
    cta: 'Записаться на сплит-тренировку',
    href: wa(MSG.split),
    open: false,
  },
  {
    num: '06',
    name: 'Индивидуально',
    mark: 'Один на&#160;один',
    aria: 'Об индивидуальной тренировке',
    text: 'Один на&#160;один с&#160;тренером. Программа учитывает ваши цели и&#160;подготовку.',
    price: 'Пробная тренировка — 1&#160;500&#160;₽. Разовое занятие — 2&#160;000&#160;₽. Абонемент на&#160;12&#160;занятий — 20&#160;000&#160;₽, действует 45&#160;дней.',
    cond: '',
    cta: 'Записаться на&#160;пробную за&#160;1&#160;500&#160;₽',
    href: wa(MSG.individual),
    open: false,
  },
];
---

<Base
  title="Клуб бокса в Хабаровске — CHAMP BOXING CLUB"
  description="Бокс для начинающих и опытных в Хабаровске. Общая, детская и женская группы, персональные занятия. Первое групповое занятие бесплатно, кроме мини-групп."
>
  <Header />

  <main id="main" tabindex="-1" class="focus:outline-none">
    <!-- 1. ПЕРВЫЙ ЭКРАН: перчатка во весь экран + тикер внутри 100svh -->
    <section id="top" aria-label="Первый экран" class="relative flex min-h-[calc(100svh-72px)] flex-col overflow-hidden">
      <div class="relative min-w-0 flex-1">
      <img
        src="/img/glove-hero.jpg"
        alt="Макро красной боксёрской перчатки: потёртая кожа, шнуровка, жёсткий студийный свет"
        class="absolute inset-0 h-full w-full object-cover"
        width="1920"
        height="1280"
        fetchpriority="high"
      />
      <div aria-hidden="true" class="absolute inset-0 bg-linear-to-t from-bg/95 via-bg/55 to-bg/25 md:bg-linear-to-r md:from-bg/90 md:via-bg/45 md:to-transparent"></div>

      <div class="hero-in relative z-10 mx-auto flex h-full max-w-[1440px] flex-col justify-center px-5 pb-6 pt-24 md:px-10">
        <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-mut">
          <span class="inline-block h-2 w-2 rotate-45 bg-flame" aria-hidden="true"></span>
          Клуб бокса — Хабаровск
        </p>

        <h1 class="mt-8 font-display font-semibold uppercase leading-[0.95] tracking-[-0.01em]">
          <span class="block text-[clamp(2.25rem,9vw,5.625rem)]">Бить не будем.</span>
          <span class="mt-3 block text-[clamp(1.375rem,4vw,2.5rem)] tracking-[0.04em] text-flame">Пока не попросишь.</span>
        </h1>

        <div id="cta-hero" class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            href={WA}
            aria-describedby="cond-hero"
            aria-label="Пробное бесплатно — записаться на&#160;групповое занятие в&#160;WhatsApp"
            class="inline-flex h-14 items-center bg-flame px-8 font-display text-sm font-semibold uppercase tracking-[0.2em] text-[#0b0a09] transition duration-200 hover:bg-bright active:bg-press active:scale-[0.97] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright"
          >
            Пробное бесплатно
          </a>
          <div>
            <p id="cond-hero" class="max-w-xs text-sm text-ink/80">Первое занятие в общей, детской или женской группе — бесплатно, кроме мини-групп.</p>
            <a href="tel:+79144234555" class="mt-2 inline-block text-sm text-ink underline underline-offset-4 transition-colors duration-200 hover:text-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright">Или позвоните: +7 (914) 423-45-55</a>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="#experience" class="inline-flex h-14 items-center gap-3 border border-linestrong px-8 font-display text-sm font-semibold uppercase tracking-[0.2em] transition duration-200 hover:border-flame hover:text-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright">
            Узнать о тренировках
            <span aria-hidden="true" class="row-arrow">↓</span>
          </a>
          <a href="#formats" class="text-sm text-ink/80 underline underline-offset-4 transition-colors duration-200 hover:text-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright">Перейти к&#160;форматам</a>
        </div>
      </div>
      </div>

      <Ticker />
    </section>

    <!-- 2. ПОЧУВСТВОВАТЬ БОКС: удар по мешку на весь экран -->
    <section id="experience" aria-labelledby="h-experience" class="relative flex min-h-[100svh] items-center overflow-hidden">
      <img
        src="/img/bag-punch.jpg"
        alt="Удар перчаткой по тяжёлому мешку, в воздухе облако пыли"
        class="absolute inset-0 h-full w-full object-cover"
        width="1920"
        height="1280"
        loading="lazy"
      />
      <div aria-hidden="true" class="absolute inset-0 bg-linear-to-t from-bg/90 via-bg/45 to-bg/25 md:bg-linear-to-r md:from-bg/90 md:via-bg/45 md:to-transparent"></div>

      <div class="relative z-10 mx-auto w-full max-w-[1440px] px-5 py-24 md:px-10" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-mut"><span class="text-flame">01</span><span class="mx-3 inline-block h-px w-10 bg-line align-middle" aria-hidden="true"></span>Почувствовать бокс</p>
        <h2 id="h-experience" class="mt-6 max-w-[14ch] font-display text-[clamp(2rem,4.5vw,3.75rem)] font-semibold uppercase leading-none">Начать можно с&#160;нуля.</h2>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="#start" class="inline-flex h-14 items-center gap-3 border border-linestrong px-8 font-display text-sm font-semibold uppercase tracking-[0.2em] transition duration-200 hover:border-flame hover:text-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright">
            Как проходит первое занятие
            <span aria-hidden="true" class="row-arrow">↓</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 3. ВЫБРАТЬ ФОРМАТ -->
    <section id="formats" aria-labelledby="h-formats" class="flex min-h-[100svh] flex-col border-t border-line">
      <div class="mx-auto my-auto max-w-[1440px] px-5 py-16 md:px-10 md:py-16" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-mut"><span class="text-flame">02</span><span class="mx-3 inline-block h-px w-10 bg-line align-middle" aria-hidden="true"></span>Найти свой формат</p>
        <h2 id="h-formats" class="mt-6 font-display text-[clamp(2rem,4.5vw,3.75rem)] font-semibold uppercase leading-none">Найди свой формат.</h2>

        <div class="mt-10 border-t border-line">
          {
            formats.map((f) => (
              <div class="border-b border-line">
                <h3 class="sr-only">{f.name}</h3>
                <details open={f.open}>
                  <summary
                    aria-label={f.aria}
                    class="group grid grid-cols-12 items-center gap-x-4 gap-y-1 px-2 py-6 transition-colors duration-200 hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright md:py-8"
                  >
                    <span class="col-span-2 text-sm text-mut md:col-span-1">{f.num}</span>
                    <span class="col-span-9 font-display text-2xl font-semibold uppercase tracking-wide transition-colors duration-200 group-hover:text-bright md:col-span-5 md:text-[28px]">{f.name}</span>
                    <span class="col-span-9 col-start-3 text-sm text-mut md:col-span-4 md:col-start-7" set:html={f.mark} />
                    <span class="col-span-3 col-start-10 flex justify-end md:col-span-2 md:col-start-12">
                      <span class="sign text-xl text-mut transition-colors duration-200 group-hover:text-flame" aria-hidden="true" />
                    </span>
                  </summary>
                  <div class="grid gap-6 px-2 pb-8 md:grid-cols-2 md:gap-x-12">
                    <div>
                      <p class="max-w-[68ch]" set:html={f.text} />
                      <p class="price-num mt-4 font-semibold" set:html={f.price} />
                    </div>
                    <div>
                      {f.cond && <p class="text-sm text-mut" set:html={f.cond} />}
                      <a
                        href={f.href}
                        class="mt-4 inline-flex h-14 items-center bg-flame px-8 font-display text-sm font-semibold uppercase tracking-[0.2em] text-[#0b0a09] transition duration-200 hover:bg-bright active:bg-press active:scale-[0.97] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright"
                        set:html={f.cta}
                      />
                    </div>
                  </div>
                </details>
              </div>
            ))
          }
        </div>

        <p class="mt-8"><a href="#prices" class="text-ink underline underline-offset-4 transition-colors duration-200 hover:text-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright">Все цены и&#160;условия</a></p>
      </div>
    </section>

    <!-- 4. ТРЕНЕРЫ -->
    <section id="coaches" aria-labelledby="h-coaches" class="flex min-h-[100svh] flex-col border-t border-line">
      <div class="mx-auto my-auto max-w-[1440px] px-5 py-16 md:px-10 md:py-16" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-mut"><span class="text-flame">03</span><span class="mx-3 inline-block h-px w-10 bg-line align-middle" aria-hidden="true"></span>Довериться и начать</p>
        <h2 id="h-coaches" class="mt-6 font-display text-[clamp(2rem,4.5vw,3.75rem)] font-semibold uppercase leading-none">Начни в&#160;своём темпе.</h2>
        <p class="mt-4 max-w-[68ch] text-sm text-mut">5&#160;тренеров — мастера спорта и&#160;кандидаты в&#160;мастера спорта по&#160;боксу.</p>
        <p class="mt-2 max-w-[68ch]">Спарринги — не&#160;сразу и&#160;только по&#160;желанию.</p>
        <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href="#coaches" class="text-ink underline underline-offset-4 transition-colors duration-200 hover:text-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright">Познакомиться с&#160;тренерами</a>
          <a href="#start" class="text-ink underline underline-offset-4 transition-colors duration-200 hover:text-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright">Как проходит первое занятие</a>
          <a href="#faq" class="text-ink underline underline-offset-4 transition-colors duration-200 hover:text-bright focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-bright">Частые вопросы</a>
        </p>

        <h3 class="mt-12 font-display text-xl font-semibold uppercase tracking-wide">Тренеры CHAMP</h3>

        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
          {
            coaches.map((c) => (
              <article class="flex flex-col border border-line">
                <img src={c.photo} alt={`Тренер ${c.name}`} width="700" height="875" class="aspect-[4/5] w-full border-b border-line object-cover" loading="lazy" />
                <div class="flex flex-1 flex-col p-5">
                  <h3 class="font-display text-xl font-semibold uppercase tracking-wide">{c.name}</h3>
                  <p class="mt-3 text-sm leading-[1.5] text-mut" set:html={c.bio} />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 5. ПЕРВОЕ ЗАНЯТИЕ -->
