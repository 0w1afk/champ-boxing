---
import Base from '../layouts/Base.astro';
import Cursor from '../components/Cursor.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Club from '../components/Club.astro';
import Programs from '../components/Programs.astro';
import Coaches from '../components/Coaches.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Клуб бокса в Хабаровске — CHAMP BOXING CLUB"
  description="Бокс для начинающих и опытных в Хабаровске. Общая, детская и женская группы, персональные занятия. Первое групповое занятие бесплатно, кроме мини-групп."
>
  <Header />
  <main id="main">
    <Hero />
    <Club />
    <Programs />
    <Coaches />
    <Pricing />
    <Faq />
    <Contacts />
  </main>
  <Footer />
  <Cursor />
</Base>
